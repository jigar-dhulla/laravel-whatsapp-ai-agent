{
    "name": "jigar-dhulla/laravel-whatsapp-ai-agent",
    "description": "A Laravel package for building WhatsApp AI agents on top of wacli.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jigar Dhulla",
            "email": "jigar.tidus@gmail.com",
            "homepage": "https://github.com/jigar-dhulla"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/ai": "^0.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelWhatsApp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelWhatsApp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelWhatsApp\\WhatsAppAgentServiceProvider"
            ]
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
